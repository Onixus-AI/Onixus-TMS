{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build --workspace @onixus/web && node scripts/bundle-api.mjs",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
