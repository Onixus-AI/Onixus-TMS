# ── API ────────────────────────────────────────────────────────────────
# Platform key (24+ characters): Onixus staff, cron jobs and n8n send it as
# "Authorization: Bearer ...", plus "X-Org-Id: <organization id>" to act
# inside one company. People sign in with Supabase Auth instead.
# Generate one: openssl rand -hex 32
TMS_API_KEY=
PORT=4000
# Comma-separated origins allowed to call the API from a browser. The first
# one is where invitation emails send people.
WEB_ORIGIN=http://localhost:5173

# ── Email: gmail | microsoft (Outlook.com / Microsoft 365) | onyx (coming soon)
EMAIL_PROVIDER=gmail
# Gmail: Google Cloud OAuth client + a refresh token for the mailbox
# (scopes gmail.send and gmail.readonly).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=dispatch@onixus.xyz
# Microsoft: Entra app registration + refresh token (Mail.Read, Mail.Send,
# offline_access). MS_TENANT_ID=common works for Outlook.com and work accounts.
MS_TENANT_ID=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REFRESH_TOKEN=

# ── CRM: hubspot | onyx (coming soon)
CRM_PROVIDER=hubspot
# HubSpot private app token (companies read/write, contacts write).
HUBSPOT_ACCESS_TOKEN=

# ── AI model: claude | openai | onyx
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Onyx serves an OpenAI-compatible endpoint.
ONYX_BASE_URL=
ONYX_API_KEY=
ONYX_MODEL=

# ── Database: supabase
DATABASE_PROVIDER=supabase
SUPABASE_URL=
# Server only. Never put this in the web app or a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# ── GPS tracking: traccar | samsara (coming soon) | motive (coming soon)
TRACKING_PROVIDER=traccar
# Traccar server (docker-compose runs one on :8082) and an API token from
# its Settings → Preferences → Token. Drivers use the free Traccar Client
# app; put the app's device identifier on the truck as its GPS tracker id.
TRACCAR_URL=http://localhost:8082
TRACCAR_TOKEN=

# ── FMCSA carrier checks (free web key: https://mobile.fmcsa.dot.gov/QCDevsite)
FMCSA_WEB_KEY=

# ── Port / terminal availability webhook. The sender signs each request:
# X-Onixus-Timestamp: <unix seconds>
# X-Onixus-Signature: hex(HMAC-SHA256(secret, "<timestamp>.<raw body>"))
PORT_WEBHOOK_SECRET=

# ── Web app (public: baked into the browser bundle)
VITE_API_URL=http://localhost:4000
# Sign-in. The project URL and the publishable (anon) key are public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Local docker-compose infrastructure
POSTGRES_PASSWORD=change-me
